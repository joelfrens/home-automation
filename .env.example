# Copy to .env (git-ignored) and replace every value: docker compose reads this file
# automatically, and ingestion/ (npm run dev / simulate) reads it too.
# Generate a password with: openssl rand -hex 16

# MQTT broker (Mosquitto) logins. Which user may do what: mosquitto/acl
# admin = you, for mosquitto_sub / mosquitto_pub while debugging
MQTT_ADMIN_PASSWORD=change-me-admin
# sensor = ESP32 sensor nodes (firmware secrets.h) and the simulator
MQTT_SENSOR_PASSWORD=change-me-sensor
MQTT_INGESTION_PASSWORD=change-me-ingestion
MQTT_LARAVEL_PASSWORD=change-me-laravel
