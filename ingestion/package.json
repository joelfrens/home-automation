{
  "name": "ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Subscribes to sensor readings on MQTT, validates them and stores them in PostgreSQL",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "simulate": "tsx src/simulator.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "mqtt": "^5.10.0",
    "pg": "^8.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
