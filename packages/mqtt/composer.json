{
    "name": "joelfrens/home-automation-mqtt",
    "description": "Shared MQTT broker connection for the home automation Laravel app: config, client factory and an mqtt:listen command that turns messages into Laravel events",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/events": "^13.0",
        "php-mqtt/client": "^2.3"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Joelfrens\\HomeAutomation\\Mqtt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joelfrens\\HomeAutomation\\Mqtt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Joelfrens\\HomeAutomation\\Mqtt\\MqttServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
