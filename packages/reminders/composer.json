{
    "name": "joelfrens/home-automation-reminders",
    "description": "Family events with early reminders for the home automation Laravel app: AI extraction from screenshots/PDFs/text, reminder scheduling and ntfy phone push",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/http": "^13.0",
        "laravel/ai": "^1.4"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Joelfrens\\HomeAutomation\\Reminders\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joelfrens\\HomeAutomation\\Reminders\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Joelfrens\\HomeAutomation\\Reminders\\RemindersServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
