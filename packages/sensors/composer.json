{
    "name": "joelfrens/home-automation-sensors",
    "description": "Sensor types, measurement storage and queries (latest per room, averaged history) for the home automation Laravel app",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/database": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Joelfrens\\HomeAutomation\\Sensors\\": "src/",
            "Joelfrens\\HomeAutomation\\Sensors\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joelfrens\\HomeAutomation\\Sensors\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Joelfrens\\HomeAutomation\\Sensors\\SensorsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
