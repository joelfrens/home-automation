{
    "name": "joelfrens/home-automation-weather",
    "description": "Outdoor weather forecast (Open-Meteo) for the home automation Laravel app: current temperature and min/max temperature and rain chance for any time window",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Joelfrens\\HomeAutomation\\Weather\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joelfrens\\HomeAutomation\\Weather\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Joelfrens\\HomeAutomation\\Weather\\WeatherServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
