APP_NAME="Home"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Values for artisan run directly on the Mac. Docker overrides DB_HOST/DB_PORT (postgres:5432).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=home
DB_USERNAME=home
DB_PASSWORD=home_dev_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Household login created by "php artisan db:seed" (registration is disabled)
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@home.local
ADMIN_PASSWORD=

# MQTT broker (packages/mqtt). Docker containers use mosquitto:1883 (set in docker-compose.yml).
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# The broker requires a login. Containers get these from the repo-root .env (docker-compose.yml);
# only needed here for artisan run directly on the host.
MQTT_USERNAME=laravel
MQTT_PASSWORD=
MQTT_SUBSCRIBE="home/+/+"

# Reverb (WebSocket server). App id/key/secret are any random strings, e.g. openssl rand -hex 16
# (or run: php artisan reverb:install). The key is public (the browser sends it); keep the secret private.
REVERB_APP_ID=home
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# AI (laravel/ai). Claude reads school letters: create a key at console.anthropic.com
# (prepaid credits; set a monthly spend limit there). Never commit the real key.
ANTHROPIC_API_KEY=
# Local models on the Mac (Ollama). From inside Docker the Mac is host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434

# School & family reminders (packages/reminders)
HOUSEHOLD_TIMEZONE=Europe/London
REMINDERS_AI_MODEL=claude-opus-5-5
# Phone push: https://ntfy.sh (free app). Each user picks a random topic in Settings → Profile.
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
# Where tapping a notification goes ({id} = event id). Use the Mac's LAN address so phones can open it.
REMINDERS_EVENT_URL="http://192.168.1.154:8000/school?event={id}"
